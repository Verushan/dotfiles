/**
 * Catppuccin Mocha for rofi - the palette settings/themes/catppuccin-mocha.json
 * hands to the qtile bar, so the launcher and the bar are drawn from the same
 * values. The layout itself is in layout.rasi.
 */

* {
    /* Straight from themes/catppuccin-mocha.json, where the accents sit 18%
       of the way towards base so they stay as quiet as the rest of the rice. */
    ground:   #1e1e2e;  /* dark     - base     */
    surface:  #313244;  /* focus    - surface0 */
    line:     #313244;  /* inactive - surface0 */
    fg:       #cdd6f4;  /* text     - text     */
    accent:   #99a1d9;  /* active   - lavender */
    info:     #7699d5;  /* color1   - blue     */
    alert:    #cd7792;  /* urgent   - red      */
    note:     #ccaeb0;  /* color4   - flamingo */

    /* Catppuccin's own greys, for the parts the bar has no colour for. */
    edge:     #45475a;  /* surface1 */
    muted:    #7f849c;  /* overlay1 */
    ash:      #585b70;  /* surface2 */

    /* 90% over the compositor's blur, as in kanagawa-dragon.rasi. */
    panel:    #1e1e2ee6;
}

@import "layout.rasi"

/* Matched query: yellow, quietened like the accents. On the lavender selected
   row it is base instead, so it stays readable. */
element-text {
    highlight: bold #d2bf98;
}

element selected.normal element-text {
    highlight: bold #1e1e2e;
}
